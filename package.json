{
  "name": "money-s3-mcp-server",
  "version": "1.0.0",
  "description": "MCP server pro Money S3 účetní systém (GraphQL API)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "money-s3-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && cp -r src/assets dist/assets",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "graphql-request": "^7.1.2",
    "graphql": "^16.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
